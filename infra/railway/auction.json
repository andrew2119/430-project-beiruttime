{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/auction/runtime/Dockerfile",
    "watchPatterns": [
      "services/auction/**",
      "packages/**",
      "contracts/**",
      "infra/foundation/discover-contracts.py",
      "infra/foundation/package-contracts.py",
      ".dockerignore",
      "infra/railway/auction.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "preDeployCommand": [
      "sh -c 'BT_DATABASE_URL=\"$BT_MIGRATION_DATABASE_URL\" python -m service_app.migrate'"
    ],
    "startCommand": "sh -c 'unset BT_MIGRATION_DATABASE_URL; exec uvicorn service_app.main:create_app --factory --host 0.0.0.0 --port 8000 --no-access-log'"
  }
}
