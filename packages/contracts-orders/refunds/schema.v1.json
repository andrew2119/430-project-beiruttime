          "format": "uuid",
          "title": "Quote Id",
          "type": "string"
        },
        "quote_revision": {
          "minimum": 1,
          "title": "Quote Revision",
          "type": "integer"
        },
        "policy_revision": {
          "minimum": 1,
          "title": "Policy Revision",
          "type": "integer"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
