          "enum": [
            "pending",
            "confirmed",
            "declined"
          ],
          "title": "State",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "pending_reason": {
          "anyOf": [
            {
              "enum": [
                "reconciliation",
                "processing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pending Reason"
        },
        "next_actor": {
          "anyOf": [
            {
              "const": "payout_operator",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Actor"
        },
        "next_review_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Review At"
        },
        "amount_minor": {
          "exclusiveMinimum": 0,
          "maximum": 9000000000000000,
          "title": "Amount Minor",
          "type": "integer"
        },
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "simulated": {
          "const": true,
          "default": true,
