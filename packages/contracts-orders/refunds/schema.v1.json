    "Operation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "refunds.v1",
          "default": "refunds.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "subject_id": {
          "format": "uuid",
          "title": "Subject Id",
          "type": "string"
        },
        "watch_id": {
          "format": "uuid",
          "title": "Watch Id",
          "type": "string"
        },
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
