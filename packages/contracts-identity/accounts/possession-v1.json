{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Listing possession challenge v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "subject_id",
    "watch_id",
    "actor_id",
    "organization_id",
    "expected_revision",
    "state",
    "revision",
    "pending_reason",
    "next_actor",
    "next_review_at",
    "listing_id",
    "watch_revision",
    "listing_revision",
    "challenge_id",
    "code",
    "issued_at",
    "expires_at",
    "submitted_at"
  ],
  "properties": {
    "schema_version": {
      "const": "identity.listing-possession.v1"
    },
    "operation_id": {
      "type": "string",
      "minLength": 8
    },
    "subject_id": {
      "type": "string"
    },
    "watch_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "null"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "issued",
        "pending",
        "expired",
        "stale",
        "approved",
        "correction",
        "rejected",
        "suspended"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "pending_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_actor": {
      "enum": [
        "seller",
        "assigned_reviewer"
      ]
    },
    "next_review_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "listing_id": {
      "type": "string"
    },
    "watch_revision": {
      "type": "integer",
      "minimum": 1
    },
    "listing_revision": {
      "type": "integer",
      "minimum": 1
    },
    "challenge_id": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "submitted_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_id",
        "proof_revision",
        "watch_revision",
        "listing_revision",
        "verdict",
        "reviewer_id",
        "assignment_revision",
        "review_revision",
        "reason"
      ],
      "properties": {
        "challenge_id": {
          "type": "string",
          "minLength": 1
        },
        "proof_revision": {
          "type": "integer",
          "minimum": 1
        },
        "watch_revision": {
          "type": "integer",
          "minimum": 1
        },
        "listing_revision": {
          "type": "integer",
          "minimum": 1
        },
        "verdict": {
          "enum": [
            "approved",
            "correction",
            "rejected",
            "suspended"
          ]
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "assignment_revision": {
          "type": "integer",
          "minimum": 1
        },
        "review_revision": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
