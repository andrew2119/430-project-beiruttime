{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private minimum offer command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "actor_id",
    "organization_id",
    "subject_id",
    "watch_id",
    "quote_id",
    "expected_revision",
    "source_revision",
    "policy_revision",
    "quote_revision",
    "schema_version",
    "minimum_minor"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,96}$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,96}$"
    },
    "organization_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,96}$"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,96}$"
    },
    "watch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,96}$"
    },
    "quote_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,96}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "quote_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "minimum_minor": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      ]
    }
  }
}
