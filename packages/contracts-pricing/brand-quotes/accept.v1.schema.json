{
  "additionalProperties": false,
  "properties": {
    "quote_revision": {
      "minimum": 1,
      "title": "Quote Revision",
      "type": "integer"
    },
    "selected_line_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 40,
      "minItems": 1,
      "title": "Selected Line Ids",
      "type": "array"
    },
    "payable_minor": {
      "exclusiveMinimum": 0,
      "maximum": 18000000000000,
      "title": "Payable Minor",
      "type": "integer"
    },
    "terms_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Terms Digest",
      "type": "string"
    },
    "accept_assessment_fee": {
      "default": false,
      "title": "Accept Assessment Fee",
      "type": "boolean"
    },
    "accept_return_fee": {
      "default": false,
      "title": "Accept Return Fee",
      "type": "boolean"
    }
  },
  "required": [
    "quote_revision",
    "selected_line_ids",
    "payable_minor",
    "terms_digest"
  ],
  "title": "AcceptQuote",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
