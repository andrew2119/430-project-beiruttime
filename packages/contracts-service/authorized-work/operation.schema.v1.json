{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "authorized-work.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "operation_id": {
      "format": "uuid",
      "title": "Operation Id",
      "type": "string"
    },
    "subject_id": {
      "format": "uuid",
      "title": "Subject Id",
      "type": "string"
    },
    "watch_id": {
      "format": "uuid",
      "title": "Watch Id",
      "type": "string"
    },
    "actor_id": {
      "format": "uuid",
      "title": "Actor Id",
      "type": "string"
    },
    "organization_id": {
      "format": "uuid",
      "title": "Organization Id",
      "type": "string"
    },
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "source_revision": {
      "minimum": 1,
      "title": "Source Revision",
      "type": "integer"
    },
    "quote_id": {
      "format": "uuid",
      "title": "Quote Id",
      "type": "string"
    },
    "quote_revision": {
      "minimum": 1,
      "title": "Quote Revision",
      "type": "integer"
    },
    "policy_revision": {
      "minimum": 1,
      "title": "Policy Revision",
      "type": "integer"
    },
    "state": {
      "enum": [
        "recorded",
        "pending",
        "paused"
      ],
      "title": "State",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "pending_reason": {
      "anyOf": [
        {
          "enum": [
            "orders_hold",
            "hold_conflict"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pending Reason"
    },
    "next_actor": {
      "format": "uuid",
      "title": "Next Actor",
      "type": "string"
    },
    "next_review_at": {
      "format": "date-time",
      "title": "Next Review At",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "since": {
      "format": "date-time",
      "title": "Since",
      "type": "string"
    },
    "escalation_at": {
      "format": "date-time",
      "title": "Escalation At",
      "type": "string"
    },
    "release_eligible": {
      "const": false,
      "title": "Release Eligible",
      "type": "boolean"
    },
    "hold_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hold Revision"
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "subject_id",
    "watch_id",
    "actor_id",
    "organization_id",
    "expected_revision",
    "source_revision",
    "quote_id",
    "quote_revision",
    "policy_revision",
    "state",
    "revision",
    "pending_reason",
    "next_actor",
    "next_review_at",
    "recorded_at",
    "since",
    "escalation_at",
    "release_eligible"
  ],
  "title": "Operation",
  "type": "object"
}
