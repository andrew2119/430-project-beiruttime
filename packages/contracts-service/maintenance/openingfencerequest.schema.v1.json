    "hold_until": {
      "format": "date-time",
      "title": "Hold Until",
      "type": "string"
    },
    "binding": {
      "$ref": "#/$defs/OpeningFenceBinding"
    }
  },
  "required": [
    "schema_version",
    "hold_until",
    "binding"
  ],
  "title": "OpeningFenceRequest",
  "type": "object"
