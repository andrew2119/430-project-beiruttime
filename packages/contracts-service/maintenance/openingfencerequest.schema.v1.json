        "order_id",
        "organization_id",
        "received_at",
        "revision",
        "valid",
        "actor_id",
        "watch_id",
        "watch_revision",
        "incident_revision",
        "current_watch_id",
        "current_watch_revision",
        "current_incident_revision"
      ],
      "title": "CurrentCustodyReceipt",
      "type": "object"
