{
  "$defs": {
    "CaseLine": {
      "additionalProperties": false,
      "properties": {
        "line_id": {
          "format": "uuid",
          "title": "Line Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Kind",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "amount_minor": {
          "maximum": 9000000000000,
          "minimum": 0,
          "title": "Amount Minor",
          "type": "integer"
        },
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "assessment_id": {
          "format": "uuid",
          "title": "Assessment Id",
          "type": "string"
        },
        "assessment_revision": {
          "minimum": 1,
          "title": "Assessment Revision",
          "type": "integer"
        }
      },
      "required": [
        "line_id",
        "kind",
        "description",
        "required",
        "amount_minor",
        "assessment_id",
        "assessment_revision"
      ],
      "title": "CaseLine",
      "type": "object"
    },
    "CurrentScope": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "subject_id": {
          "format": "uuid",
          "title": "Subject Id",
          "type": "string"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        },
        "watch_id": {
          "format": "uuid",
          "title": "Watch Id",
          "type": "string"
        },
        "quote_id": {
          "format": "uuid",
          "title": "Quote Id",
          "type": "string"
        },
        "quote_revision": {
          "minimum": 1,
          "title": "Quote Revision",
          "type": "integer"
        },
        "policy_revision": {
          "minimum": 1,
          "title": "Policy Revision",
          "type": "integer"
        },
        "terms_revision": {
          "minimum": 1,
          "title": "Terms Revision",
          "type": "integer"
        },
        "terms": {
          "$ref": "#/$defs/RetainedTerms"
        },
        "total_minor": {
          "maximum": 999999999999,
          "minimum": 0,
          "title": "Total Minor",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "actor_id",
        "subject_id",
        "organization_id",
        "watch_id",
        "quote_id",
        "quote_revision",
        "policy_revision",
        "terms_revision",
        "terms",
        "total_minor",
        "scope"
      ],
      "title": "CurrentScope",
      "type": "object"
    },
    "LocalizedTerm": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "En",
          "type": "string"
        },
        "ar": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Ar",
          "type": "string"
        }
      },
      "required": [
        "en",
        "ar"
      ],
      "title": "LocalizedTerm",
      "type": "object"
    },
    "RetainedTerms": {
      "additionalProperties": false,
      "properties": {
        "lead_time": {
          "$ref": "#/$defs/LocalizedTerm"
        },
        "fees": {
          "$ref": "#/$defs/LocalizedTerm"
        },
        "return_terms": {
          "$ref": "#/$defs/LocalizedTerm"
        },
        "assurance": {
          "$ref": "#/$defs/LocalizedTerm"
        },
        "conditions": {
          "$ref": "#/$defs/LocalizedTerm"
        }
      },
      "required": [
        "lead_time",
        "fees",
        "return_terms",
        "assurance",
        "conditions"
      ],
      "title": "RetainedTerms",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "service.case-lines.v1",
          "default": "service.case-lines.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "request_revision": {
          "minimum": 1,
          "title": "Request Revision",
          "type": "integer"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/CaseLine"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Lines",
          "type": "array"
        },
        "accepted_line_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Accepted Line Ids",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "request_revision",
        "revision",
        "lines",
        "accepted_line_ids"
      ],
      "title": "Scope",
      "type": "object"
    },
    "ScopeReceipt": {
      "additionalProperties": false,
      "if": {
        "properties": {
          "state": {
            "const": "accepted"
          }
        },
        "required": [
          "state"
        ]
      },
      "properties": {
        "schema_version": {
          "const": "service.case-lines.v1",
          "default": "service.case-lines.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "subject_id": {
          "format": "uuid",
          "title": "Subject Id",
          "type": "string"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        },
        "watch_id": {
          "format": "uuid",
          "title": "Watch Id",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "request_revision": {
          "minimum": 1,
          "title": "Request Revision",
          "type": "integer"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "quote_id": {
          "format": "uuid",
          "title": "Quote Id",
          "type": "string"
        },
        "quote_revision": {
          "minimum": 1,
          "title": "Quote Revision",
          "type": "integer"
        },
        "policy_revision": {
          "minimum": 1,
          "title": "Policy Revision",
          "type": "integer"
        },
        "accepted_terms_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted Terms Revision"
        },
        "terms_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms Digest"
        },
        "state": {
          "enum": [
            "accepted",
            "denied",
            "stale",
            "pending"
          ],
          "title": "State",
          "type": "string"
        },
        "revision": {
          "description": "An accepted result has exactly the expected revision plus one.",
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "pending_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pending Reason"
        },
        "next_actor": {
          "enum": [
            "customer",
            "business",
            "support"
          ],
          "title": "Next Actor",
          "type": "string"
        },
        "next_review_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Review At"
        },
        "case_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "assessment_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessment Id"
        },
        "assessment_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessment Revision"
        }
      },
      "required": [
        "operation_id",
        "actor_id",
        "subject_id",
        "organization_id",
        "watch_id",
        "request_id",
        "request_revision",
        "expected_revision",
        "quote_id",
        "quote_revision",
        "policy_revision",
        "state",
        "revision",
        "next_actor"
      ],
      "then": {
        "properties": {
          "accepted_terms_revision": {
            "minimum": 1,
            "type": "integer"
          },
          "terms_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "accepted_terms_revision",
          "terms_digest"
        ]
      },
      "title": "ScopeReceipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "current": {
      "$ref": "#/$defs/CurrentScope"
    },
    "acceptance": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScopeReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "current"
  ],
  "title": "CurrentScopeResult",
  "type": "object"
}
