{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact payment readiness result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "actor_id",
    "organization_id",
    "subject_id",
    "watch_id",
    "buyer_id",
    "order_id",
    "order_kind",
    "quote_id",
    "quote_revision",
    "request_revision",
    "authority_revision",
    "payment_revision",
    "currency",
    "total_minor",
    "schema_version",
    "expected_revision",
    "revision",
    "state",
    "pending_reason",
    "next_actor",
    "next_review_at",
    "message",
    "identity_pass",
    "execution_authorized",
    "next_action",
    "escalate_at"
  ],
  "properties": {
    "operation_id": {},
    "actor_id": {},
    "organization_id": {},
    "subject_id": {},
    "watch_id": {},
    "buyer_id": {},
    "order_id": {},
    "order_kind": {},
    "quote_id": {},
    "quote_revision": {},
    "request_revision": {},
    "authority_revision": {},
    "payment_revision": {},
    "currency": {},
    "total_minor": {},
    "schema_version": {
      "const": "eligibility.capacity.v1"
    },
    "expected_revision": {},
    "revision": {},
    "state": {
      "enum": [
        "paid",
        "pending",
        "unpaid",
        "denied"
      ]
    },
    "pending_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_actor": {},
    "next_review_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "ar"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "ar": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "identity_pass": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "escalate_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "ar"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "ar": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "paid",
              "unpaid"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "actor_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "organization_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "subject_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "watch_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "buyer_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "order_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "order_kind": {
            "const": "job"
          },
          "quote_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "quote_revision": {
            "type": "integer",
            "minimum": 1
          },
          "request_revision": {
            "type": "integer",
            "minimum": 1
          },
          "authority_revision": {
            "type": "integer",
            "minimum": 1
          },
          "payment_revision": {
            "type": "integer",
            "minimum": 1
          },
          "currency": {
            "const": "USD"
          },
          "total_minor": {
            "type": "integer",
            "minimum": 1
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "next_actor": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "pending"
          }
        }
      },
      "then": {
        "properties": {
          "next_actor": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "next_review_at": {
            "type": "string",
            "format": "date-time"
          },
          "escalate_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "else": {
        "properties": {
          "next_review_at": {
            "type": "null"
          },
          "escalate_at": {
            "type": "null"
          }
        }
      }
    }
  ]
}
