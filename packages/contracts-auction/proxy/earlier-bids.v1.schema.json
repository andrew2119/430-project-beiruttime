{
  "title": "Earlier own bid receipts",
  "type": "object",
  "additionalProperties": false,
  "required": ["auction_id", "items", "next_cursor"],
  "properties": {
    "auction_id": { "type": "string", "format": "uuid" },
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "recorded_at", "state"],
        "properties": {
          "operation_id": { "type": "string", "format": "uuid" },
          "recorded_at": { "type": "string", "format": "date-time" },
          "state": { "enum": ["accepted", "denied", "stale"] }
        }
      }
    },
    "next_cursor": { "type": ["string", "null"], "format": "uuid" }
  }
}
