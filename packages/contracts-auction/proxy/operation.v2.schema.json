{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "maximum": 2,
      "minimum": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "operation_id": {
      "format": "uuid",
      "title": "Operation Id",
      "type": "string"
    },
    "actor_id": {
      "format": "uuid",
      "title": "Actor Id",
      "type": "string"
    },
    "organization_id": {
      "title": "Organization Id",
      "type": "null"
    },
    "subject_id": {
      "format": "uuid",
      "title": "Subject Id",
      "type": "string"
    },
    "watch_id": {
      "format": "uuid",
      "title": "Watch Id",
      "type": "string"
    },
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "quote_id": {
      "format": "uuid",
      "title": "Quote Id",
      "type": "string"
    },
    "quote_revision": {
      "minimum": 1,
      "title": "Quote Revision",
      "type": "integer"
    },
    "policy_revision": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Policy Revision",
      "type": "string"
    },
    "state": {
      "enum": ["accepted", "denied", "stale", "pending"],
      "title": "State",
      "type": "string"
    },
    "pending_reason": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pending Reason"
    },
    "next_actor": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Actor"
    },
    "next_review_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Review At"
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "actor_id",
    "organization_id",
    "subject_id",
    "watch_id",
    "expected_revision",
    "revision",
    "quote_id",
    "quote_revision",
    "policy_revision",
    "state",
    "pending_reason",
    "next_actor",
    "next_review_at"
  ],
  "title": "MaximumOperation",
  "type": "object"
}
