  "messages": {
    "no_sale": {
      "en": "The auction ended without a sale.",
      "ar": "انتهى المزاد دون بيع."
    },
    "stale_revision": {
      "en": "Reload the current auction and review your action.",
      "ar": "أعد تحميل المزاد الحالي وراجع الإجراء."
    },
    "legacy_outcome_review": {
      "en": "The auction ended. The previous purchase outcome is under review. Contact support.",
      "ar": "انتهى المزاد. نتيجة الشراء السابق قيد المراجعة. تواصل مع الدعم."
    },
    "cancellation_pending": {
      "en": "Cancellation is pending. Check this same request again.",
      "ar": "الإلغاء قيد الانتظار. تحقق من الطلب نفسه مجدداً."
    },
    "cancelled": {
      "en": "The auction is cancelled.",
      "ar": "تم إلغاء المزاد."
    },
    "allocation_pending": {
      "en": "The winner is recorded. Order allocation is pending.",
      "ar": "تم تسجيل الفائز. تخصيص الطلب قيد الانتظار."
    },
    "auction_final": {
      "en": "The auction result is final. Review the current record.",
      "ar": "نتيجة المزاد نهائية. راجع السجل الحالي."
    },
    "auction_ended": {
      "en": "The auction has ended. Review the current result.",
      "ar": "انتهى المزاد. راجع النتيجة الحالية."
    },
    "auction_not_ended": {
      "en": "The auction has not ended. Check again at its scheduled end.",
      "ar": "لم ينته المزاد. تحقق مجدداً في موعد نهايته المحدد."
    },
    "cancellation_denied": {
      "en": "Cancellation is unavailable. Review the accepted bids and current commitment.",
      "ar": "الإلغاء غير متاح. راجع المزايدات المقبولة والالتزام الحالي."
    },
    "currency_reconciliation_required": {
      "en": "This auction is unavailable while its currency is under review. Contact support.",
      "ar": "هذا المزاد غير متاح أثناء مراجعة عملته. تواصل مع الدعم."
    }
  },
  "recovery": {
    "lost_response": "lookup with the original command",
    "unknown_release": "retain cancellation_pending",
    "duplicate": "return the original receipt"
  }
