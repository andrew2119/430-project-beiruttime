{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order timeline v1",
  "oneOf": [
    {
      "$ref": "#/$defs/timeline"
    },
    {
      "$ref": "#/$defs/page"
    }
  ],
  "$defs": {
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "order_id",
        "watch_id",
        "reference",
        "operation_id",
        "revision",
        "currency",
        "simulated",
        "as_of",
        "economics",
        "waiting",
        "milestones",
        "financial"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "order-timeline.v1"
          ]
        },
        "order_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "watch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "reference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "currency": {
          "enum": [
            "USD"
          ]
        },
        "simulated": {
          "const": true
        },
        "as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "economics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principal_minor",
            "buyer_fee_minor",
            "business_fee_minor",
            "total_minor",
            "quote_id",
            "quote_revision"
          ],
          "properties": {
            "principal_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "buyer_fee_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "business_fee_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "quote_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            "quote_revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "waiting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "party",
            "since",
            "action",
            "operator_id",
            "next_review_at",
            "follow_up"
          ],
          "properties": {
            "party": {
              "enum": [
                "buyer",
                "seller",
                "business",
                "operator",
                "authenticator"
              ]
            },
            "since": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "action": {
              "enum": [
                "pay",
                "review",
                "receive",
                "inspect",
                "work",
                "reconcile",
                "wait"
              ]
            },
            "operator_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            "next_review_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "follow_up": {
              "enum": [
                "scheduled",
                "due",
                "escalated"
              ]
            }
          }
        },
        "milestones": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/milestone"
                },
                {
                  "properties": {
                    "source": {
                      "const": "orders"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/milestone"
                },
                {
                  "properties": {
                    "source": {
                      "const": "payments"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/milestone"
                },
                {
                  "properties": {
                    "source": {
                      "const": "inspection"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/milestone"
                },
                {
                  "properties": {
                    "source": {
                      "const": "custody"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/milestone"
                },
                {
                  "properties": {
                    "source": {
                      "const": "progress"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/milestone"
                },
                {
                  "properties": {
                    "source": {
                      "const": "settlement"
                    }
                  }
                }
              ]
            }
          ]
        },
        "financial": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/financial"
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "items",
        "total",
        "offset",
        "limit"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "order-timeline-list.v1"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "order_id",
              "reference"
            ],
            "properties": {
              "order_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
              },
              "reference": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
              }
            }
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "operation_id",
        "order_id",
        "watch_id",
        "revision",
        "state",
        "occurred_at",
        "amount_minor",
        "quote_id",
        "quote_revision"
      ],
      "properties": {
        "schema_version": {
          "const": "timeline-source.v1"
        },
        "source": {
          "enum": [
            "orders",
            "payments",
            "inspection",
            "custody",
            "progress",
            "settlement"
          ]
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "order_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "watch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "pending",
            "confirmed",
            "blocked",
            "not_applicable"
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "amount_minor": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "quote_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "quote_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "currency": {
          "const": "USD"
        },
        "economics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principal_minor",
            "buyer_fee_minor",
            "business_fee_minor",
            "total_minor",
            "quote_id",
            "quote_revision"
          ],
          "properties": {
            "principal_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "buyer_fee_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "business_fee_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "quote_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            "quote_revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "waiting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "party",
            "action",
            "operator_id",
            "since",
            "last_progress_at"
          ],
          "properties": {
            "party": {
              "enum": [
                "buyer",
                "seller",
                "business",
                "operator",
                "authenticator"
              ]
            },
            "since": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "action": {
              "enum": [
                "pay",
                "review",
                "receive",
                "inspect",
                "work",
                "reconcile",
                "wait"
              ]
            },
            "operator_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            "last_progress_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          }
        },
        "financial": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/financial"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "orders"
              }
            }
          },
          "then": {
            "required": [
              "reference",
              "currency",
              "economics",
              "waiting"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "payments",
                  "settlement"
                ]
              }
            }
          },
          "then": {
            "required": [
              "financial"
            ]
          }
        }
      ]
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "organization_id",
        "order_id",
        "watch_id",
        "access_revision",
        "source_revisions"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "organization_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "order_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "watch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "access_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "source_revisions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "enum": [
                  "orders",
                  "payments",
                  "inspection",
                  "custody",
                  "progress",
                  "settlement"
                ]
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            ]
          }
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "state",
        "revision",
        "occurred_at",
        "amount_minor",
        "operation_id"
      ],
      "properties": {
        "source": {
          "enum": [
            "orders",
            "payments",
            "inspection",
            "custody",
            "progress",
            "settlement"
          ]
        },
        "state": {
          "enum": [
            "pending",
            "confirmed",
            "blocked",
            "unavailable",
            "not_applicable"
          ]
        },
        "revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "occurred_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "amount_minor": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "operation_id": {
                "type": "null"
              },
              "revision": {
                "type": "null"
              },
              "occurred_at": {
                "type": "null"
              },
              "amount_minor": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "operation_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "occurred_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              }
            }
          }
        }
      ]
    },
    "financial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "state",
        "amount_minor",
        "operation_id",
        "revision",
        "occurred_at",
        "source"
      ],
      "properties": {
        "kind": {
          "enum": [
            "gross",
            "collected_fee",
            "refund",
            "net",
            "payout"
          ]
        },
        "state": {
          "enum": [
            "pending",
            "confirmed",
            "blocked"
          ]
        },
        "source": {
          "enum": [
            "payments",
            "settlement"
          ]
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    }
  }
}
