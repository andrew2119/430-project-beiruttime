{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Listing questions v1 command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "watch_id",
    "question_id",
    "kind",
    "source_revision",
    "expected_revision",
    "text"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_-]{1,200}$"
    },
    "watch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_-]{1,200}$"
    },
    "question_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_-]{1,200}$"
    },
    "kind": {
      "enum": [
        "ask",
        "answer",
        "report",
        "hide",
        "appeal"
      ]
    },
    "source_revision": {
      "type": "integer",
      "minimum": 0
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    }
  }
}
