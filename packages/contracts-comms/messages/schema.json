{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:beirut-time:communications:messages:v1",
  "title": "Private message command and receipt",
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "expected_revision",
        "source_revision",
        "quote_revision",
        "policy_revision",
        "kind"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "quote_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "enum": [
            "send",
            "read",
            "block",
            "unblock",
            "report",
            "appeal",
            "delivery"
          ]
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "send"
              }
            }
          },
          "then": {
            "required": [
              "body"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "read"
              }
            }
          },
          "then": {
            "required": [
              "sequence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "block"
              }
            }
          },
          "then": {
            "required": [
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unblock"
              }
            }
          },
          "then": {
            "required": [
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "report"
              }
            }
          },
          "then": {
            "required": [
              "body",
              "sequence"
            ],
            "properties": {
              "body": {
                "maxLength": 1000
              },
              "sequence": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "appeal"
              }
            }
          },
          "then": {
            "required": [
              "body",
              "sequence"
            ],
            "properties": {
              "body": {
                "maxLength": 1000
              },
              "sequence": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "delivery"
              }
            }
          },
          "then": {
            "required": [
              "body"
            ],
            "properties": {
              "body": {
                "maxLength": 500
              }
            }
          }
        }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation_id",
        "state",
        "revision"
      ],
      "properties": {
        "schema_version": {
          "const": "communications.messages.v1"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "state": {
          "const": "accepted"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/command"
    },
    {
      "$ref": "#/$defs/receipt"
    }
  ]
}
