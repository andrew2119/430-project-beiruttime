{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Movement operation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "subject_id",
    "watch_id",
    "actor_id",
    "organization_id",
    "expected_revision",
    "state",
    "revision",
    "pending_reason",
    "next_actor",
    "next_review_at"
  ],
  "properties": {
    "schema_version": {
      "const": "movement.operation.v1"
    },
    "operation_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "watch_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor_id": {
      "type": "string"
    },
    "organization_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "saved",
        "denied",
        "stale",
        "pending"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "pending_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_review_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "archived": {
      "type": "boolean"
    }
  }
}
