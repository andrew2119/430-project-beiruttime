{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beirut Time release operation binding",
  "type": "object",
  "required": ["schema_version", "operation_id", "subject_id", "watch_id", "actor_id", "organization_id", "expected_revision", "state", "revision", "retained_quote_id", "policy_revision", "pending_reason", "next_actor", "next_review_at"],
  "properties": {
    "schema_version": {"const": "L22.E09.v1"},
    "operation_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "watch_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "minLength": 1},
    "retained_quote_id": {"type": "string", "minLength": 1},
    "policy_revision": {"type": "string", "minLength": 1},
    "expected_revision": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 1},
    "state": {"enum": ["accepted", "denied", "stale", "pending"]},
    "pending_reason": {"type": ["string", "null"]},
    "next_actor": {"type": ["string", "null"]},
    "next_review_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false,
  "allOf": [{
    "if": {"properties": {"state": {"const": "pending"}}},
    "then": {"properties": {
      "pending_reason": {"type": "string", "minLength": 1},
      "next_actor": {"type": "string", "minLength": 1},
      "next_review_at": {"type": "string", "format": "date-time"}
    }}
  }]
}
