{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic restore result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "subject_id", "watch_id", "actor_id", "organization_id", "expected_revision", "quote_revision", "policy_revision", "state", "revision", "pending_reason", "next_actor", "next_review_at"],
  "properties": {
    "schema_version": {"const": "l24.restore.v1"},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "subject_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "watch_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "actor_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "organization_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "expected_revision": {"type": "integer", "minimum": 1},
    "quote_revision": {"type": "integer", "minimum": 1},
    "policy_revision": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 1},
    "state": {"enum": ["complete", "missing_file", "denied", "stale", "pending", "unavailable"]},
    "pending_reason": {"type": ["string", "null"], "maxLength": 128},
    "next_actor": {"type": ["string", "null"], "maxLength": 128},
    "next_review_at": {"type": ["string", "null"], "format": "date-time", "maxLength": 40}
  }
}
