{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beirut Time local proof contracts",
  "schema_version": "l25.schema.v1",
  "$defs": {
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "expected_revision",
        "next_actor",
        "next_review_at",
        "operation_id",
        "organization_id",
        "pending_reason",
        "revision",
        "schema_version",
        "state",
        "subject_id",
        "watch_id"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "next_actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_review_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "organization_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "pending_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "schema_version": {
          "const": "l25.operation.v1"
        },
        "state": {
          "enum": [
            "success",
            "denied",
            "stale",
            "pending",
            "unavailable"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "watch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "proxy_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "bidder_id",
        "amount_minor",
        "sequence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "manual",
            "maximum"
          ]
        },
        "bidder_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "quote_commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_id",
        "order_id",
        "quote_revision",
        "total_minor",
        "committed_at"
      ],
      "properties": {
        "buyer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "order_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "quote_revision": {
          "type": "integer",
          "minimum": 1
        },
        "total_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "committed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "payment_notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "notice_id",
        "order_id",
        "buyer_id",
        "notified_at",
        "verified_delivery_recorded"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "notice_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "order_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "buyer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "notified_at": {
          "type": "string",
          "format": "date-time"
        },
        "verified_delivery_recorded": {
          "const": true
        }
      }
    },
    "paid_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_id",
        "order_id",
        "order_kind",
        "watch_id",
        "quote_id",
        "quote_revision",
        "currency",
        "total_minor",
        "payment_operation_id",
        "payment_revision",
        "state"
      ],
      "properties": {
        "buyer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "order_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "order_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "watch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "quote_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "quote_revision": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "const": "USD"
        },
        "total_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "payment_operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "payment_revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "paid_held",
            "pending",
            "unpaid"
          ]
        }
      }
    }
  }
}
