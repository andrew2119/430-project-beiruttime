  "case_assertions": {
    "positive": "Use actual ordered producer operations, verify current source facts and exact resulting revision; no seeded paid, winner, pass, receipt, work or release.",
    "denied": "Revoke current permission or assignment before action; private read and write deny with no commercial mutation.",
    "stale": "Change source revision, scope, consent or quote before action; reject old acceptance and preserve retained history.",
    "cross_account": "Use another identity with the same operation reference; deny private access and writes, clear the old private view.",
    "cross_business": "Switch selected organization or revoke membership; deny old business access even with an open screen.",
    "timeout": "Bound the dependency request; retain pending/unavailable with responsible owner, next action and review time.",
    "lost_response": "Lose response after acknowledgement, read current operation, retry the identical binding; one durable effect.",
    "duplicate": "Replay identical operation and callback; same receipt, one allocation, charge, refund, notice and job. Conflicting binding denies.",
    "restart": "Restart after acknowledged mutation and before response; retained revision and operation recover without lost bid or duplicate work.",
    "recovery": "Resolve the same pending reference from authoritative source; preserve owned draft and exact economics; never guess success."
  },
  "protected_assertions": {
    "auction": [
      "Canonical serialized admission alone determines order.",
      "Opening 400000; step 10000; maximum 450000 opens at 400000; challenger 420000 produces 430000 automatic response.",
      "At public 430000, challenger 445000 or 450000 leads; displaced 450000 ceiling is inactive until raised.",
      "Use band at challenger amount; no equal public rows or public ceilings; leader ceiling raise creates no public bid.",
      "Before end admits; equal/after end rejects; original end never extends.",
      "No bids or public final below reserve means no winner/order; unused ceiling cannot meet reserve.",
      "Winner allocation is once; unknown allocation cannot select another winner.",
      "Auction purchase is denied; no-bid cancellation allowed, cancellation after bid denied; legacy purchase uncertainty holds while auction ends."
    ],
    "purchase": [
      "Race fixed purchase, accepted offer and winner against one physical watch: exactly one exclusive commitment.",
      "Signed simulated callbacks bind actor, order, method, quote revision, currency, amount and operation. Test wrong signature and every mismatched binding.",
      "Durable required inbox notice and verified-recipient record precede payment clock; failed publication leaves null deadline.",
      "Identical notice replay is idempotent; conflicting event/buyer/order/timestamp denies.",
      "No attempt or only final declines releases atomically at expiry; pending/unknown/held money never releases on timer.",
      "Late conflicting confirmation goes to reconciliation/refund review, never another sale."
    ],
    "custody": [
      "Private route requires paid held, expert physical receipt, current independent assignment and actual current pass.",
      "Dealer and brand route requires current onboarding/assurance and no invented pass.",
      "Dispatch, appointment and prepared states cannot establish receipt; wrong watch/recipient/condition blocks.",
      "Failed inspection blocks buyer handover and payout; seller 25000 commission plus disclosed return trip collected once before controlled return. Decline/unknown remains held.",
      "72h private and 168h business/job dispute windows start at actual receipt; before/equal/after release boundary and timely/late dispute boundary are checked.",
      "Loss/damage, open dispute, uncertain transfer or changed recipient blocks release."
    ],
    "customization": [
      "Exactly five immutable versioned option snapshots; save upload attachment explicitly; stale/incompatible options remain correctable.",
      "Active official brand only; dealer customization denied; assessor, approver and quality reviewer distinct, eligibility reviewer separate from buyer/approver.",
      "Accepted quote precedes identity eligibility and brand approval; approval precedes payment; exact payment readiness precedes production.",
      "Consent withdrawal immediately removes effectiveness; grant prepare/consume/revoke serialized; stale consent/assessment/quote/assignment denies execution.",
      "Production requires current accepted scope, approval, exclusive allocation and confirmed platform-held payment; material change pauses work.",
      "Purchase then customization uses two linked sequential orders, completed purchase receipt/window before separate brand custody and payment."
    ],
    "service": [
      "Brand/dealer current supported scope only; cross-business and unsupported intervention deny.",
      "Confirmed Beirut appointment is distinct from custody; missing/repeated civil times require correction or explicit disambiguation.",
      "Reported symptoms are not diagnosis; opening needs exact permission; current custody and explicit accepted mandatory/chosen optional lines precede paid work.",
      "17.5 cm remains exactly 175 mm; ambiguous or implausible input corrects.",
      "New fault/price/part requires renewed acceptance; delay never permits substitution.",
      "Quality records actual tests/fit/returned parts; failure reworks; later incident invalidates earlier readiness."
    ],
    "economics": [
      "USD integer cents only; reject boolean, float, nonfinite, negative and unsafe amounts; half-up one-cent rounding.",
      "500000 watch: buyer fee 15000, buyer total 515000, seller commission 25000, ordinary net 475000 for every seller type.",
      "500000 job: customer total 500000, single business fee 25000, business net 475000; aliases never double-deduct.",
      "Watch refund maximum 500000 excludes collected fees; unresolved and confirmed refunds reserve the same maximum.",
      "Full job refund returns permitted gross principal, business fee remains one receivable/collection; unknown collection never creates another customer refund.",
      "Retained economics with null expiry never authorizes execution; preview before/equal/after 15-minute boundary, offer 48h boundary tested."
    ],
    "privacy_bounds": [
      "Restricted evidence never enters public photos, events, logs, previews or result records.",
      "Listing photos: JPEG/PNG, 8 MB each, 20 million decoded pixels, 12 photos, five separate private files, 40 MB total; test below/equal/above.",
      "Dial references: three PNG files, 1 MiB each, permitted dimensions; intake evidence ten files, 256 KiB each; below/equal/above.",
      "Bound requests/retries/import rows; stable operation scope cannot cross actor/business/subject/revision.",
      "Never persist passwords/private bytes; locale switch preserves same mounted form and operation without implicit submission."
    ],
    "display": [
      "EN/AR, RTL, light/dark, desktop and actual 390x844; assert innerWidth equals 390.",
      "Loading, empty, denied, pending, error, retry, unavailable with complete bilingual next actions.",
      "Long mixed Arabic/Latin, emoji, missing facts, counts 0/1/large, 1000 rows with actual pagination/server totals.",
      "Keyboard/focus, reduced motion, safe areas, 16px coarse-pointer inputs and 44px targets; screenshot and geometry checks.",
      "Password/private file retention, session switch clearing, exact total and pending reference retention.",
      "Record actual per-page read key, warming, retained answer, first frame and size measurements; physical phone remains owed."
    ]
  },
