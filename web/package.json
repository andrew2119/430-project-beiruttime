{
  "name": "beirut-time-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-nav.mjs && next dev --hostname 0.0.0.0",
    "build": "node scripts/generate-nav.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "node scripts/generate-nav.mjs && tsc --noEmit",
    "lint": "cd .. && web/node_modules/.bin/eslint --config web/eslint.config.mjs web packages/ui/src --max-warnings 0",
    "test": "vitest run && node scripts/test-features.mjs",
    "ui:rules": "node scripts/check-ui-rules.mjs",
    "test:ui-rules": "node --test scripts/check-ui-rules.test.mjs && vitest run tests/worst-case.test.ts --maxWorkers 1"
  },
  "dependencies": {
    "@beirut-time/contracts-core": "workspace:*",
    "@beirut-time/i18n": "workspace:*",
    "@beirut-time/ui": "workspace:*",
    "@tanstack/react-query": "5.105.3",
    "clsx": "2.1.1",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
