        "path": "/internal/v1/lane-composition/enable",
        "producer": "service-local-runtime",
        "receipt_key": [
          "operation_id",
          "step_id"
        ],
        "authority": "authenticated-runtime-only"
      }
    ],
    "authority": "current-provider-only",
    "unknown_result": "pending",
    "retry": "same-operation-id",
    "activation_order": [
      "migrate",
      "subscribe",
      "enable"
    ],
    "dependency_policy": {
      "timeout_ms": 1500,
      "request_budget_ms": 4000,
      "failure_threshold": 3,
      "open_ms": 30000,
      "max_in_flight": 1
    },
    "states": {
      "pending": {
        "en": "The result is pending. Retry with the same action reference.",
        "ar": "النتيجة قيد الانتظار. أعد المحاولة بمرجع الإجراء نفسه."
      },
      "denied": {
        "en": "Access is denied. Check your current permissions.",
        "ar": "الوصول مرفوض. تحقق من صلاحياتك الحالية."
      },
      "stale": {
        "en": "The record changed. Review the current version.",
        "ar": "تغيّر السجل. راجع النسخة الحالية."
      },
      "unavailable": {
        "en": "The service is unavailable. Try again later.",
        "ar": "الخدمة غير متاحة. حاول مجدداً لاحقاً."
      }
    },
    "request": {
      "schema_version": "lane-composition.v1",
      "required": [
        "operation_id",
        "step_id",
        "module",
        "event",
        "destination"
      ],
      "revision_rule": "same-reference-requires-identical-metadata",
      "unknown_result": "pending"
    },
