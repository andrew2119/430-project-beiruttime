      {
        "operation_id": "lane-composition.migrate.v1",
        "method": "POST",
        "path": "/internal/v1/lane-composition/migrate",
        "producer": "service-local-runtime",
        "receipt_key": [
          "operation_id",
          "step_id"
        ],
        "authority": "authenticated-runtime-only"
      },
      {
        "operation_id": "lane-composition.subscribe.v1",
